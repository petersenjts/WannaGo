generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Vertical {
  STAY
  DINE
}

enum RequestStatus {
  NEW
  IN_PROGRESS
  SENT_TO_CUSTOMER
  SELECTED // customer picked an option from the shortlist, concierge needs to book it
  BOOKED
  CLOSED_LOST
}

enum PartnerVertical {
  HOTEL
  RESTAURANT
}

enum ExploreListingReviewStatus {
  PENDING_REVIEW
  REJECTED
}

enum DiscoveryTrigger {
  ADMIN
  CRON
}

enum DiscoveryBlockedReason {
  KILL_SWITCH
  DAILY_LIMIT
  MONTHLY_LIMIT
  RATE_LIMIT
}

// A person, identified across both verticals by normalized email/phone.
// This is the join point that makes cross-vertical tracking possible.
model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  phone     String?  @unique
  createdAt DateTime @default(now())

  requests        Request[]
  exploreVisitors ExploreVisitor[]

  @@index([email])
  @@index([phone])
}

model Request {
  id         String        @id @default(cuid())
  vertical   Vertical
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id])
  city       String
  status     RequestStatus @default(NEW)

  // free text from the consumer at submission time
  consumerNotes String?

  stayDetails      StayDetails?
  diningDetails    DiningDetails?
  partnerContacts  PartnerContact[]
  shortlistOptions ShortlistOption[] @relation("RequestOptions")

  // The customer's pick from the shortlist, set by their own portal action.
  selectedOptionId String?          @unique
  selectedOption   ShortlistOption? @relation("SelectedOption", fields: [selectedOptionId], references: [id])
  selectedAt       DateTime?

  // Final outcome, logged by the concierge for monthly partner invoicing.
  finalPartnerId             String?
  finalPartner                Partner? @relation(fields: [finalPartnerId], references: [id])
  finalPartnerNameIfUnlisted String?
  finalPrice                  Decimal? @db.Decimal(10, 2)
  outcomeNotes                String?
  closedAt                    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vertical])
  @@index([status])
  @@index([customerId])
}

model StayDetails {
  id        String   @id @default(cuid())
  requestId String   @unique
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)

  checkIn        DateTime
  checkOut       DateTime
  guests         Int
  budgetPerNight Decimal  @db.Decimal(10, 2)
  preferenceTags String[] @default([])
}

model DiningDetails {
  id        String  @id @default(cuid())
  requestId String  @unique
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  date            DateTime
  time            String
  partySize       Int
  budgetPerPerson Decimal  @db.Decimal(10, 2)
  occasion        String?
  cuisine         String?
  dietaryNeeds    String?
}

// A log entry of a partner the concierge reached out to for a given request,
// and what they quoted. Several per request is normal.
model PartnerContact {
  id        String  @id @default(cuid())
  requestId String
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  partnerId             String?
  partner               Partner? @relation(fields: [partnerId], references: [id])
  partnerNameIfUnlisted String?

  quote     Decimal? @db.Decimal(10, 2)
  notes     String?
  createdAt DateTime @default(now())
}

// The curated shortlist sent back to the consumer (~5 for hotels, effectively
// 1 recommendation for dining).
model ShortlistOption {
  id        String  @id @default(cuid())
  requestId String
  request   Request @relation("RequestOptions", fields: [requestId], references: [id], onDelete: Cascade)

  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id])

  name      String
  photoUrl  String?
  price     Decimal? @db.Decimal(10, 2)
  notes     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  selectedForRequest Request? @relation("SelectedOption")
}

// A curated catalog listing shown in the public Explore swipe deck / grid.
// Distinct from Partner (CRM/invoicing) — a listing doesn't need to be an
// onboarded partner, it's just something worth showing off.
model ExploreListing {
  id              String   @id @default(cuid())
  vertical        Vertical
  name            String
  slug            String   @unique // generated once at creation, stable even if name changes later
  description     String?
  longDescription String? // full write-up, shown with prominence on the listing's own page
  neighborhood    String?
  priceLevel   Int // 1-4, shown as €/€€/€€€/€€€€
  tags         String[] @default([]) // free text, no fixed vocabulary
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Google Places enrichment (optional — a listing can be fully manual).
  // googlePlaceId is exempt from Google's caching restrictions and can be
  // stored indefinitely; it's what "refresh from Google" looks up again.
  // Not @unique: a hard constraint would throw a confusing Prisma error if
  // the same real place ever got linked to two listings.
  googlePlaceId          String?
  googleFormattedAddress String?
  googleRating           Float?
  googleReviewCount      Int?
  cuisine                String? // DINE only; derived from Google's primaryTypeDisplayName
  googleLastSyncedAt     DateTime?

  // AI discovery draft review (optional — a listing can be fully manual).
  // null for every manually-created or already-approved listing; only set
  // while a draft is awaiting admin review or has been rejected. Orthogonal
  // to `active` — approving a draft just clears this to null.
  reviewStatus      ExploreListingReviewStatus?
  aiSourceUrls      String[]  @default([]) // website URLs actually used as generation sources
  aiUncertainClaims String[]  @default([]) // claims the model flagged as unsure about
  aiGeneratedAt     DateTime?

  // Claim verification (a second Claude call checking the generated text
  // against aiSourceExcerpts) — gates Approve when it finds unsupported
  // claims. aiOriginal* are snapshots taken once at generation time, never
  // updated again, purely so an edit can be detected (current description
  // differs from the snapshot) without a separate "edited" flag to maintain.
  aiSourceExcerpts          Json? // [{url,text}] — the scraped text actually sent to Claude
  aiClaimChecks             Json? // [{text,supported,note}] from verifyClaims; [] when no sources existed
  aiOriginalDescription     String?
  aiOriginalLongDescription String?
  approvedWithOverride      Boolean @default(false)

  photos ExploreListingPhoto[]
  swipes ExploreSwipe[]
  views  ExploreListingView[]

  @@index([vertical, active])
  @@index([googlePlaceId])
  @@index([reviewStatus])
}

model ExploreListingPhoto {
  id        String         @id @default(cuid())
  listingId String
  listing   ExploreListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
}

// An anonymous browser identity for Explore swiping. The id *is* the cookie
// value directly (a crypto.randomUUID() set by proxy.ts) — not an auth
// mechanism, just a preference-tracking handle. Created lazily on first
// swipe. customerId is intentionally not unique: the same person can
// accumulate more than one visitor row across devices before any of them
// gets linked.
model ExploreVisitor {
  id         String    @id
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  createdAt  DateTime  @default(now())

  swipes ExploreSwipe[]

  @@index([customerId])
}

model ExploreSwipe {
  id        String         @id @default(cuid())
  visitorId String
  visitor   ExploreVisitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  listingId String
  listing   ExploreListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  liked     Boolean
  createdAt DateTime       @default(now())

  @@unique([visitorId, listingId])
}

// A detail-page open, for funnel measurement. visitorId is a plain string,
// not a relation to ExploreVisitor — that row is only created lazily on
// first swipe, so a pure page view very often has no matching visitor row
// yet; forcing a relation would mean either creating one on every view or
// an unenforceable nullable FK. A plain string is enough for view counts.
model ExploreListingView {
  id        String         @id @default(cuid())
  listingId String
  listing   ExploreListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  visitorId String?
  createdAt DateTime       @default(now())

  @@index([listingId])
  @@index([createdAt])
}

// Admin-editable spend controls for the AI discovery agent. Single row
// (id is always "singleton"), read via a self-healing upsert so the row
// materializes with defaults on first use — no seed migration needed.
model DiscoverySettings {
  id                   String    @id @default("singleton")
  dailyPlaceLimit      Int       @default(50)
  monthlyPlaceLimit    Int       @default(500)
  maxCapPerRun         Int       @default(30)
  cronRateLimitPerHour Int       @default(2)
  killSwitchEnabled    Boolean   @default(true)
  cronSecretHash       String? // sha256 hex digest only — plaintext is never stored
  cronSecretUpdatedAt  DateTime?
  updatedAt            DateTime  @updatedAt
}

// One row per discovery run attempt, including ones refused by a safeguard
// (blockedReason set, zero places processed) — the admin dashboard's recent
// runs list shows both so a quiet kill-switch/limit block is still visible.
model DiscoveryRunLog {
  id                 String                  @id @default(cuid())
  startedAt          DateTime                @default(now())
  finishedAt         DateTime?
  trigger            DiscoveryTrigger
  area               String
  vertical           Vertical
  placesCreated      Int                     @default(0)
  placesSkipped      Int                     @default(0)
  errorCount         Int                     @default(0)
  googleCallCount    Int                     @default(0)
  claudeInputTokens  Int                     @default(0)
  claudeOutputTokens Int                     @default(0)
  estimatedCostUsd   Decimal                 @default(0) @db.Decimal(10, 4)
  blockedReason      DiscoveryBlockedReason?
  // Set when the run threw before completing (e.g. the Google Places call
  // failed outright — bad key, API not enabled, a restricted key rejecting
  // server-side calls). Distinct from blockedReason, which is a safeguard
  // refusal, not a failure. Null for both a normal completed run and a
  // blocked one.
  errorMessage       String?

  @@index([startedAt])
  @@index([trigger, startedAt])
}

// Lightweight partner CRM. Commission rate is derived from vertical
// (12% hotel / 10% restaurant), not stored per-partner.
model Partner {
  id             String          @id @default(cuid())
  name           String
  vertical       PartnerVertical
  city           String
  contactInfo    String?
  trialStartDate DateTime        @default(now())
  notes          String?
  createdAt      DateTime        @default(now())

  contactedFor   PartnerContact[]
  shortlistedIn  ShortlistOption[]
  bookedRequests Request[]

  @@index([vertical])
}
