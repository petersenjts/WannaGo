# Postgres connection string. For local dev, point this at a free Neon/Railway/Supabase
# Postgres instance — see README for setup. For production, Railway injects this automatically
# when you attach a Postgres plugin to this service.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Admin login (single operator, no roles).
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="choose-a-strong-password"

# Random long string used to sign the admin session cookie and customer magic links.
# Generate one with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-random-32-byte-string"

# The site's own public URL — used to build absolute links in emails.
APP_URL="http://localhost:3000"

# Resend (resend.com) — sends magic-link / "your options are ready" emails to
# customers. Requires verifying your sending domain's DNS with Resend first.
# Leave unset locally and the app will log magic links to the console instead
# of sending real email, so you can test the whole flow without an account.
RESEND_API_KEY=""
EMAIL_FROM="Wannago Concierge <hello@example.com>"

# Cloudinary (cloudinary.com) — stores photos uploaded for shortlist options.
# Required for the file-upload field to work (pasting a photo URL instead
# still works without this). From your Cloudinary dashboard: Settings ->
# API Keys, or just copy the "API Environment variable" it shows you, which
# is already in this exact CLOUDINARY_URL format.
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
