# Postgres connection string. For local dev, point this at a free Neon/Railway/Supabase
# Postgres instance — see README for setup. For production, Railway injects this automatically
# when you attach a Postgres plugin to this service.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Admin login (single operator, no roles).
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="choose-a-strong-password"

# Random long string used to sign the admin session cookie.
# Generate one with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-random-32-byte-string"
